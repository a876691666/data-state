{
  "name": "tvt-data-state",
  "private": false,
  "version": "1.0.3",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build:all": "npm run build && npm run build:docs",
    "build": "vite build --config vite.npm.config.ts",
    "build:docs": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "example:basic": "node --loader ts-node/esm examples/basic-usage.ts",
    "example:advanced": "node --loader ts-node/esm examples/advanced-usage.ts",
    "example:ultra": "node --loader ts-node/esm examples/ultra-simple-usage.ts",
    "demo": "npm run example:ultra",
    "quick-start": "node scripts/quick-start.js",
    "setup": "npm install && npm run build && echo '✅ 项目设置完成！运行 npm run demo 查看极简API演示'",
    "test": "echo '暂无测试，运行 npm run demo 查看极简API演示'",
    "help": "node scripts/help.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3"
  },
  "dependencies": {}
}
